# Optional: override the model used by the in-game chat companion.
# Defaults to claude-haiku-4-5-20251001 (cheap, fast, plenty for command-driven chat).
# CLAUDE_BRAIN_MODEL=claude-sonnet-5
# Optional: how many recent user messages of chat history to keep per request.
# Defaults to 12 — older turns are dropped so a long play session doesn't keep
# growing the request size (and cost) forever.
# CLAUDE_BRAIN_MAX_HISTORY_TURNS=12

